# ─── Application ────────────────────────────────────────────────────
NODE_ENV=development
FUNCTIONS_LOCALE=fr-CI
FUNCTIONS_TIMEZONE=Africa/Abidjan
MAX_IMAGE_SIZE_MB=10
CLEANUP_DAYS_THRESHOLD=90

