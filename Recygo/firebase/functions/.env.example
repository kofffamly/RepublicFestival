## ─── Firebase ────────────────────────────────────────────────────────
FIREBASE_API_KEY=AIzaSyYourFirebaseApiKeyHere
FIREBASE_PROJECT_ID=recygo-ci-dev
FIREBASE_STORAGE_BUCKET=recygo-ci-dev.appspot.com
# FIREBASE_DATABASE_URL=https://recygo-ci-dev.firebaseio.com

# ─── Gemini AI ──────────────────────────────────────────────────────
GEMINI_API_KEY=AIzaSyYourActualApiKeyHere
GEMINI_MODEL=gemini-2.0-flash-exp
GEMINI_MAX_TOKENS=4096
GEMINI_TEMPERATURE=0.3
GEMINI_TOP_P=0.95
