# ─── Firebase Client SDK (RecyGo CI) ────────────────────────────────
# Copy this file to .env and fill in your actual Firebase credentials.
#
# 🔧  Get the values from:
#    Firebase Console → Project Settings → Your apps → Web app
#    https://console.firebase.google.com/project/recygo-ci-dev/settings/general/
# ─────────────────────────────────────────────────────────────────────

# Google API key (starts with AIza…)
EXPO_PUBLIC_FIREBASE_API_KEY=

# Firebase project auth domain
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=recygo-ci-dev.firebaseapp.com

# Firebase project ID
EXPO_PUBLIC_FIREBASE_PROJECT_ID=recygo-ci-dev

# Cloud Storage bucket
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=recygo-ci-dev.appspot.com

# Cloud Messaging sender ID (numeric string)
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Firebase web app ID (format: 1:<sender-id>:web:<hash>)
EXPO_PUBLIC_FIREBASE_APP_ID=

# Optional: Firebase measurement ID for Analytics
# Only required if you use Firebase Analytics in the web app
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=

# ─── Optional: Firebase Emulator ─────────────────────────────────────
# Set to 'true' to use the local Firebase emulator suite
# For a real Firebase project build, leave this set to false.
EXPO_PUBLIC_USE_FIREBASE_EMULATOR=false

# Optional: Demo mode for local UI development without a backend
# Only use when EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
EXPO_PUBLIC_DEMO_MODE=false
